#!/usr/bin/env bash
# Repo-local pre-commit hook for balloon-fresh.
#
# WHY THIS EXISTS. The fleet keeps a global core.hooksPath (~/.git-hooks) whose GATE 3 deliberately
# chains to the repository's OWN hook at <git-common-dir>/hooks/pre-commit. This repo had NO such hook,
# so repo-specific gates had nowhere to live. This file is that hook.
#
# It runs the cheap, commit-time gates that the fleet hook does not know about:
#   1. FAB READINESS GUARD -- refuses to publish a hub board with less routing than the recorded state.
#      This is the Astra gap-analysis item H1: the canonical board file is the one a fab order is cut
#      from, and it was sitting PLACED-ONLY (2 tracks on 1 net) while the real routed result lived in a
#      separate artifact. One careless commit could have shipped a silently non-functional board.
#   2. ERC on the flight schematic -- the schematic-to-board electrical check that DRC cannot do.
#
# Design notes:
#   - FAST: only runs a gate when a file it cares about is actually staged, so ordinary commits are
#     unaffected. A full ERC takes seconds, not minutes.
#   - LOUD: a missing tool prints a warning and does NOT silently pass. A gate that cannot run must be
#     visible as "not run", never as "green".
#   - OVERRIDABLE but AUDITABLE: FAB_GUARD_ACK="reason" allows an intentional regression, and the hook
#     tells you to record the reason in the commit message. SKIP_FAB_GUARD=1 skips entirely (last
#     resort; prints a warning).
set -uo pipefail

if [ "${SKIP_FAB_GUARD:-}" = "1" ]; then
    echo "fab-guard: SKIPPED via SKIP_FAB_GUARD=1 -- the fab readiness gates did NOT run."
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

GUARD="tracker/hardware/fab_readiness_guard.py"
FAILED=0

staged() { git diff --cached --name-only --diff-filter=ACM | grep -E "$1" || true; }

# ---------------------------------------------------------------- 1. fab readiness
BOARDS="$(staged 'hub_board.*\.kicad_pcb$|wing_board.*\.kicad_pcb$|base_station.*\.kicad_pcb$')"
if [ -n "$BOARDS" ]; then
    echo "fab-guard: board file(s) staged -- checking routability against the recorded state"
    while IFS= read -r b; do
        [ -z "$b" ] && continue
        # check the STAGED content, not the working tree
        TMP="$(mktemp -d)"
        mkdir -p "$TMP/$(dirname "$b")"
        git show ":$b" > "$TMP/$b" 2>/dev/null || { rm -rf "$TMP"; continue; }
        if ! python3 "$GUARD" --check "$TMP/$b"; then
            FAILED=1
        fi
        rm -rf "$TMP"
    done <<< "$BOARDS"
fi

# ---------------------------------------------------------------- 2. ERC on the schematic
SCH="$(staged 'schematics/.*\.kicad_sch$')"
if [ -n "$SCH" ]; then
    ERC="tracker/hardware/run_erc.sh"
    if [ -x "$ERC" ] || [ -f "$ERC" ]; then
        echo "erc-guard: schematic staged -- running ERC"
        if ! bash "$ERC"; then
            echo "erc-guard: ERC reported problems (see above)."
            FAILED=1
        fi
    else
        echo "erc-guard: WARNING -- $ERC not found, so NO electrical-rule check ran."
        echo "           A gate that cannot run must not look green; install it or accept the gap."
    fi
fi

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "pre-commit: REFUSING the commit (see the gate output above)."
    exit 1
fi
exit 0
