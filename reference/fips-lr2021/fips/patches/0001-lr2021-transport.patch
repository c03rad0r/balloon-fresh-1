+++ b/crates/fips-lr2021/src/bin/fips-lr2021d.rs
@@ -0,0 +1,278 @@
+//! `fips-lr2021d` — stock-FIPS UDP fallback daemon for the LR2021 bridge.
+//!
+//! FIPS is configured with a normal UDP transport pointing at this daemon.
+//! Every UDP datagram becomes a link-layer frame; every reassembled radio
+//! frame becomes a UDP datagram back to FIPS.
+
+use std::net::{SocketAddr, UdpSocket};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use clap::Parser;
+use crossbeam_channel::unbounded;
+use fips_lr2021::bridge::{BridgeKind, RxPayload};
+use fips_lr2021::{Band, Link, Lr2021Config, SerialBridge, send_packets};
+
+#[derive(Debug, Parser)]
+#[command(about = "FIPS over LR2021/FLRC UDP daemon")]
+struct Args {
+    #[arg(long, default_value = "/dev/ttyACM0")]
+    serial: String,
+    #[arg(long, default_value_t = 2_000_000)]
+    baud: u32,
+    #[arg(long, default_value = "us2400")]
+    band: String,
+    #[arg(long)]
+    frequency_hz: Option<u32>,
+    #[arg(long)]
+    bitrate_kbps: Option<u16>,
+    #[arg(long)]
+    power_dbm: Option<i8>,
+    #[arg(long, default_value_t = 1)]
+    local_id: u32,
+    #[arg(long, default_value_t = 2)]
+    peer_id: u32,
+    #[arg(long, default_value = "127.0.0.1:2122")]
+    udp_bind: String,
+    /// Fixed FIPS UDP address. If omitted, replies go to the last sender.
+    #[arg(long)]
+    fips_peer: Option<String>,
+    #[arg(long)]
+    relay: bool,
+    #[arg(long)]
+    mtu: Option<u16>,
+    #[arg(long, default_value_t = 255)]
+    radio_payload: u16,
+}
+
+fn now_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
+
+fn main() {
+    let args = Args::parse();
+    let band = Band::parse(&args.band).unwrap_or_else(|| {
+        eprintln!("unknown band '{}', using us2400", args.band);
+        Band::Us2400
+    });
+    let cfg = Lr2021Config {
+        port: Some(args.serial.clone()),
+        baud: Some(args.baud),
+        band: Some(band),
+        frequency_hz: args.frequency_hz,
+        bitrate_kbps: args.bitrate_kbps,
+        tx_power_dbm: args.power_dbm,
+        local_id: Some(args.local_id),
+        relay: Some(args.relay),
+        mtu: args.mtu,
+        radio_payload: Some(args.radio_payload),
+        ..Lr2021Config::default()
+    };
+    let bridge_cfg = cfg.bridge_config().unwrap_or_else(|e| fatal(&e));
+    let link_cfg = cfg.link_config().unwrap_or_else(|e| fatal(&e));
+
+    eprintln!(
+        "opening {} at {} baud, band {} ({} Hz, FLRC {} kbps, {} dBm, payload {}B)",
+        bridge_cfg.port,
+        bridge_cfg.baud,
+        bridge_cfg.profile.band.as_str(),
+        bridge_cfg.profile.frequency_hz,
+        bridge_cfg.profile.bitrate_kbps,
+        bridge_cfg.profile.tx_power_dbm,
+        bridge_cfg.profile.radio_payload
+    );
+
+    let (reader, _) = fips_lr2021::open_device(&bridge_cfg, link_cfg.clone())
+        .unwrap_or_else(|e| fatal(&e.to_string()));
+    let mut writer = reader
+        .try_clone()
+        .unwrap_or_else(|e| fatal(&format!("cannot clone serial port: {e}")));
+    eprintln!(
+        "bridge ready; local id {:#010x}, peer id {:#010x}",
+        args.local_id, args.peer_id
+    );
+
+    let link = Arc::new(Mutex::new(
+        Link::new(link_cfg.clone()).unwrap_or_else(|e| fatal(&e.to_string())),
+    ));
+    let stop = Arc::new(AtomicBool::new(false));
+    let socket =
+        Arc::new(UdpSocket::bind(&args.udp_bind).unwrap_or_else(|e| fatal(&e.to_string())));
+    socket
+        .set_read_timeout(Some(Duration::from_millis(200)))
+        .unwrap_or_else(|e| fatal(&e.to_string()));
+    let fixed_peer: Option<SocketAddr> = args
+        .fips_peer
+        .as_deref()
+        .and_then(|s: &str| s.parse::<SocketAddr>().ok());
+    let last_peer: Arc<Mutex<Option<SocketAddr>>> = Arc::new(Mutex::new(fixed_peer));
+
+    let (tx_out, rx_out) = unbounded::<Vec<Vec<u8>>>();
+    let (tx_udp, rx_udp) = unbounded::<Vec<u8>>();
+
+    // Single serial writer: all radio packets and ACKs go through here.
+    let writer_stop = Arc::clone(&stop);
+    thread::spawn(move || {
+        while !writer_stop.load(Ordering::Relaxed) {
+            match rx_out.recv_timeout(Duration::from_millis(200)) {
+                Ok(packets) => {
+                    if let Err(e) = send_packets(&mut writer, &packets) {
+                        eprintln!("serial write error: {e}");
+                    }
+                }
+                Err(_) => {}
+            }
+        }
+    });
+
+    // Serial reader: RX packets -> link -> ACKs/delivered.
+    let reader_link = Arc::clone(&link);
+    let reader_stop = Arc::clone(&stop);
+    let reader_tx_out = tx_out.clone();
+    let reader_tx_udp = tx_udp.clone();
+    let reader_socket = Arc::clone(&socket);
+    let reader_peer = Arc::clone(&last_peer);
+    thread::spawn(move || {
+        let mut bridge: SerialBridge = reader;
+        while !reader_stop.load(Ordering::Relaxed) {
+            let frames = match bridge.read_frames(50) {
+                Ok(frames) => frames,
+                Err(e) => {
+                    eprintln!("serial read error: {e}");
+                    thread::sleep(Duration::from_millis(100));
+                    continue;
+                }
+            };
+            for frame in frames {
+                match frame.kind {
+                    BridgeKind::Rx => {
+                        let Some(rx) = RxPayload::decode(&frame.payload) else {
+                            continue;
+                        };
+                        let mut link = reader_link.lock().unwrap();
+                        match link.process(&rx.data, now_ms()) {
+                            Ok(outcome) => {
+                                if !outcome.outbound.is_empty() {
+                                    let _ = reader_tx_out.send(outcome.outbound);
+                                }
+                                for (_, data) in outcome.delivered {
+                                    let peer = *reader_peer.lock().unwrap();
+                                    if let Some(peer) = peer {
+                                        if let Err(e) = reader_socket.send_to(&data, peer) {
+                                            eprintln!("udp send error: {e}");
+                                        }
+                                    } else {
+                                        let _ = reader_tx_udp.send(data);
+                                    }
+                                }
+                            }
+                            Err(e) => eprintln!("link rx drop: {e}"),
+                        }
+                    }
+                    BridgeKind::Evt => {
+                        eprintln!("bridge event: {}", String::from_utf8_lossy(&frame.payload))
+                    }
+                    BridgeKind::Stat => {
+                        if let Some(stat) = fips_lr2021::bridge::StatPayload::decode(&frame.payload)
+                        {
+                            eprintln!(
+                                "bridge stats tx={} rx={} crc={} drops={} timeouts={} resets={}",
+                                stat.tx_packets,
+                                stat.rx_packets,
+                                stat.crc_errors,
+                                stat.drops,
+                                stat.tx_timeouts,
+                                stat.resets
+                            );
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+    });
+
+    // Retransmit timer.
+    let timer_link = Arc::clone(&link);
+    let timer_stop = Arc::clone(&stop);
+    let timer_tx = tx_out.clone();
+    thread::spawn(move || {
+        while !timer_stop.load(Ordering::Relaxed) {
+            thread::sleep(Duration::from_millis(10));
+            let packets = timer_link.lock().unwrap().poll(now_ms());
+            if !packets.is_empty() {
+                let _ = timer_tx.send(packets);
+            }
+        }
+    });
+
+    // UDP side: FIPS datagrams become link frames.
+    let udp_link = Arc::clone(&link);
+    let udp_stop = Arc::clone(&stop);
+    let udp_tx = tx_out.clone();
+    let udp_peer = Arc::clone(&last_peer);
+    thread::spawn(move || {
+        let mut buf = [0u8; 2048];
+        while !udp_stop.load(Ordering::Relaxed) {
+            match socket.recv_from(&mut buf) {
+                Ok((n, src)) => {
+                    let mut peer = udp_peer.lock().unwrap();
+                    if peer.is_none() {
+                        *peer = Some(src);
+                    }
+                    drop(peer);
+                    if n > link_cfg.mtu as usize {
+                        eprintln!("dropping oversized UDP datagram: {n} bytes");
+                        continue;
+                    }
+                    let packets =
+                        match udp_link
+                            .lock()
+                            .unwrap()
+                            .submit(&buf[..n], args.peer_id, now_ms())
+                        {
+                            Ok(packets) => packets,
+                            Err(e) => {
+                                eprintln!("link tx drop: {e}");
+                                continue;
+                            }
+                        };
+                    let _ = udp_tx.send(packets);
+                }
+                Err(e)
+                    if e.kind() == std::io::ErrorKind::WouldBlock
+                        || e.kind() == std::io::ErrorKind::TimedOut => {}
+                Err(e) => {
+                    eprintln!("udp recv error: {e}");
+                    thread::sleep(Duration::from_millis(100));
+                }
+            }
+            while let Ok(data) = rx_udp.try_recv() {
+                let peer = *udp_peer.lock().unwrap();
+                if let Some(peer) = peer {
+                    if let Err(e) = socket.send_to(&data, peer) {
+                        eprintln!("udp send error: {e}");
+                    }
+                }
+            }
+        }
+    });
+
+    eprintln!(
+        "UDP listening on {}; configure FIPS transports.udp to point here",
+        args.udp_bind
+    );
+    while !stop.load(Ordering::Relaxed) {
+        thread::sleep(Duration::from_millis(500));
+    }
+}
+
+fn fatal(message: &str) -> ! {
+    eprintln!("fatal: {message}");
+    std::process::exit(1);
+}
diff --git a/crates/fips-lr2021/src/bridge.rs b/crates/fips-lr2021/src/bridge.rs
new file mode 100644
index 00000000..35095217
--- /dev/null
+++ b/crates/fips-lr2021/src/bridge.rs
@@ -0,0 +1,461 @@
+//! Host↔bridge protocol over USB CDC.
+//!
+//! ```text
+//! [A5 5A][type:1][len:2 LE][payload][CRC16:2 LE]
+//! ```
+
+use std::io::{self, Read, Write};
+use std::time::Duration;
+
+use thiserror::Error;
+
+use crate::config::{Band, RadioProfile};
+use crate::crc::crc16;
+
+pub const MAGIC: [u8; 2] = [0xA5, 0x5A];
+pub const MAX_PAYLOAD: usize = 2048;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[repr(u8)]
+pub enum BridgeKind {
+    Hello = 1,
+    HelloAck = 2,
+    Cfg = 3,
+    CfgAck = 4,
+    Tx = 5,
+    Rx = 6,
+    Stat = 7,
+    Evt = 8,
+    Ping = 9,
+    Pong = 10,
+}
+
+impl BridgeKind {
+    pub fn from_u8(value: u8) -> Option<Self> {
+        match value {
+            1 => Some(Self::Hello),
+            2 => Some(Self::HelloAck),
+            3 => Some(Self::Cfg),
+            4 => Some(Self::CfgAck),
+            5 => Some(Self::Tx),
+            6 => Some(Self::Rx),
+            7 => Some(Self::Stat),
+            8 => Some(Self::Evt),
+            9 => Some(Self::Ping),
+            10 => Some(Self::Pong),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BridgeFrame {
+    pub kind: BridgeKind,
+    pub payload: Vec<u8>,
+}
+
+pub fn encode(kind: BridgeKind, payload: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(6 + payload.len() + 2);
+    out.extend_from_slice(&MAGIC);
+    out.push(kind as u8);
+    out.extend_from_slice(&(payload.len() as u16).to_le_bytes());
+    out.extend_from_slice(payload);
+    let crc = crc16(&out[2..]);
+    out.extend_from_slice(&crc.to_le_bytes());
+    out
+}
+
+/// Incremental decoder. It is deliberately tolerant of leading garbage, which
+/// matters after a USB reconnect or a bridge reset.
+#[derive(Debug, Default)]
+pub struct BridgeDecoder {
+    buf: Vec<u8>,
+}
+
+impl BridgeDecoder {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn push(&mut self, data: &[u8]) -> Vec<BridgeFrame> {
+        self.buf.extend_from_slice(data);
+        let mut out = Vec::new();
+        loop {
+            if self.buf.len() < 5 {
+                break;
+            }
+            if self.buf[0..2] != MAGIC {
+                let next = self
+                    .buf
+                    .windows(2)
+                    .position(|w| w == MAGIC)
+                    .unwrap_or(self.buf.len());
+                self.buf.drain(..next.max(1));
+                continue;
+            }
+            let len = u16::from_le_bytes([self.buf[3], self.buf[4]]) as usize;
+            if len > MAX_PAYLOAD {
+                self.buf.drain(..1);
+                continue;
+            }
+            let total = 7 + len;
+            if self.buf.len() < total {
+                break;
+            }
+            let expected = u16::from_le_bytes([self.buf[total - 2], self.buf[total - 1]]);
+            let actual = crc16(&self.buf[2..total - 2]);
+            if expected != actual {
+                self.buf.drain(..1);
+                continue;
+            }
+            if let Some(kind) = BridgeKind::from_u8(self.buf[2]) {
+                out.push(BridgeFrame {
+                    kind,
+                    payload: self.buf[5..total - 2].to_vec(),
+                });
+            }
+            self.buf.drain(..total);
+        }
+        out
+    }
+}
+
+#[derive(Debug, Error)]
+pub enum BridgeError {
+    #[error("serial port: {0}")]
+    Serial(#[from] serialport::Error),
+    #[error("io: {0}")]
+    Io(#[from] io::Error),
+    #[error("protocol: {0}")]
+    Protocol(String),
+}
+
+/// Blocking serial wrapper. The caller owns the read and write loops.
+pub struct SerialBridge {
+    port: Box<dyn serialport::SerialPort>,
+    decoder: BridgeDecoder,
+}
+
+impl SerialBridge {
+    pub fn open(path: &str, baud: u32) -> Result<Self, BridgeError> {
+        let port = serialport::new(path, baud)
+            .timeout(Duration::from_millis(50))
+            .open()?;
+        Ok(Self {
+            port,
+            decoder: BridgeDecoder::new(),
+        })
+    }
+
+    pub fn try_clone(&self) -> Result<Self, BridgeError> {
+        Ok(Self {
+            port: self.port.try_clone()?,
+            decoder: BridgeDecoder::new(),
+        })
+    }
+
+    pub fn write_frame(&mut self, kind: BridgeKind, payload: &[u8]) -> Result<(), BridgeError> {
+        let bytes = encode(kind, payload);
+        self.port.write_all(&bytes)?;
+        self.port.flush()?;
+        Ok(())
+    }
+
+    /// Read whatever is available and return complete bridge frames.
+    pub fn read_frames(&mut self, timeout_ms: u64) -> Result<Vec<BridgeFrame>, BridgeError> {
+        self.port
+            .set_timeout(Duration::from_millis(timeout_ms.max(1)))?;
+        let mut buf = [0u8; 512];
+        let mut out = Vec::new();
+        match self.port.read(&mut buf) {
+            Ok(0) => {}
+            Ok(n) => out.extend(self.decoder.push(&buf[..n])),
+            Err(err) if err.kind() == io::ErrorKind::TimedOut => {}
+            Err(err) if err.kind() == io::ErrorKind::Interrupted => {}
+            Err(err) => return Err(BridgeError::Io(err)),
+        }
+        Ok(out)
+    }
+}
+
+/// Radio configuration sent in a `Cfg` frame.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct CfgPayload {
+    pub profile: RadioProfile,
+    pub relay: bool,
+}
+
+impl CfgPayload {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut flags = 0u8;
+        if self.relay {
+            flags |= 0x01;
+        }
+        if self.profile.sub_ghz {
+            flags |= 0x02;
+        }
+        let mut out = Vec::with_capacity(15);
+        out.push(band_to_u8(self.profile.band));
+        out.extend_from_slice(&self.profile.frequency_hz.to_le_bytes());
+        out.extend_from_slice(&self.profile.bitrate_kbps.to_le_bytes());
+        out.push(self.profile.tx_power_dbm as u8);
+        out.extend_from_slice(&self.profile.sync_word);
+        out.extend_from_slice(&self.profile.radio_payload.to_le_bytes());
+        out.push(flags);
+        out
+    }
+
+    pub fn decode(payload: &[u8]) -> Option<Self> {
+        if payload.len() != 15 {
+            return None;
+        }
+        let band = band_from_u8(payload[0])?;
+        let frequency_hz = u32::from_le_bytes(payload[1..5].try_into().ok()?);
+        let bitrate_kbps = u16::from_le_bytes(payload[5..7].try_into().ok()?);
+        let tx_power_dbm = payload[7] as i8;
+        let sync_word = payload[8..12].try_into().ok()?;
+        let radio_payload = u16::from_le_bytes(payload[12..14].try_into().ok()?);
+        let flags = payload[14];
+        let profile = RadioProfile {
+            band,
+            frequency_hz,
+            bitrate_kbps,
+            tx_power_dbm,
+            sync_word,
+            radio_payload,
+            sub_ghz: flags & 0x02 != 0,
+        };
+        profile.validate().ok()?;
+        Some(Self {
+            profile,
+            relay: flags & 0x01 != 0,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct CfgAckPayload {
+    pub status: u8,
+    pub frequency_hz: u32,
+    pub bitrate_kbps: u16,
+    pub tx_power_dbm: i8,
+    pub radio_payload: u16,
+}
+
+impl CfgAckPayload {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(10);
+        out.push(self.status);
+        out.extend_from_slice(&self.frequency_hz.to_le_bytes());
+        out.extend_from_slice(&self.bitrate_kbps.to_le_bytes());
+        out.push(self.tx_power_dbm as u8);
+        out.extend_from_slice(&self.radio_payload.to_le_bytes());
+        out
+    }
+
+    pub fn decode(payload: &[u8]) -> Option<Self> {
+        if payload.len() != 10 {
+            return None;
+        }
+        Some(Self {
+            status: payload[0],
+            frequency_hz: u32::from_le_bytes(payload[1..5].try_into().ok()?),
+            bitrate_kbps: u16::from_le_bytes(payload[5..7].try_into().ok()?),
+            tx_power_dbm: payload[7] as i8,
+            radio_payload: u16::from_le_bytes(payload[8..10].try_into().ok()?),
+        })
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct HelloAckPayload {
+    pub protocol: u8,
+    pub firmware: [u8; 3],
+    pub chip_id: u16,
+    pub capabilities: u16,
+}
+
+impl HelloAckPayload {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(8);
+        out.push(self.protocol);
+        out.extend_from_slice(&self.firmware);
+        out.extend_from_slice(&self.chip_id.to_le_bytes());
+        out.extend_from_slice(&self.capabilities.to_le_bytes());
+        out
+    }
+
+    pub fn decode(payload: &[u8]) -> Option<Self> {
+        if payload.len() != 8 {
+            return None;
+        }
+        Some(Self {
+            protocol: payload[0],
+            firmware: payload[1..4].try_into().ok()?,
+            chip_id: u16::from_le_bytes(payload[4..6].try_into().ok()?),
+            capabilities: u16::from_le_bytes(payload[6..8].try_into().ok()?),
+        })
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RxPayload {
+    pub rssi_dbm: i16,
+    pub snr_db: i8,
+    pub crc_ok: bool,
+    pub data: Vec<u8>,
+}
+
+impl RxPayload {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(6 + self.data.len());
+        out.extend_from_slice(&self.rssi_dbm.to_le_bytes());
+        out.push(self.snr_db as u8);
+        out.push(u8::from(self.crc_ok));
+        out.extend_from_slice(&(self.data.len() as u16).to_le_bytes());
+        out.extend_from_slice(&self.data);
+        out
+    }
+
+    pub fn decode(payload: &[u8]) -> Option<Self> {
+        if payload.len() < 6 {
+            return None;
+        }
+        let len = u16::from_le_bytes(payload[4..6].try_into().ok()?) as usize;
+        if payload.len() != 6 + len {
+            return None;
+        }
+        Some(Self {
+            rssi_dbm: i16::from_le_bytes(payload[0..2].try_into().ok()?),
+            snr_db: payload[2] as i8,
+            crc_ok: payload[3] != 0,
+            data: payload[6..].to_vec(),
+        })
+    }
+}
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct StatPayload {
+    pub tx_packets: u32,
+    pub rx_packets: u32,
+    pub crc_errors: u32,
+    pub drops: u32,
+    pub tx_timeouts: u32,
+    pub resets: u32,
+}
+
+impl StatPayload {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(24);
+        for value in [
+            self.tx_packets,
+            self.rx_packets,
+            self.crc_errors,
+            self.drops,
+            self.tx_timeouts,
+            self.resets,
+        ] {
+            out.extend_from_slice(&value.to_le_bytes());
+        }
+        out
+    }
+
+    pub fn decode(payload: &[u8]) -> Option<Self> {
+        if payload.len() != 24 {
+            return None;
+        }
+        let mut values = [0u32; 6];
+        for (i, value) in values.iter_mut().enumerate() {
+            *value = u32::from_le_bytes(payload[i * 4..i * 4 + 4].try_into().ok()?);
+        }
+        Some(Self {
+            tx_packets: values[0],
+            rx_packets: values[1],
+            crc_errors: values[2],
+            drops: values[3],
+            tx_timeouts: values[4],
+            resets: values[5],
+        })
+    }
+}
+
+pub fn band_to_u8(band: Band) -> u8 {
+    match band {
+        Band::Eu868 => 0,
+        Band::Eu868High => 1,
+        Band::Us915 => 2,
+        Band::Us915Robust => 3,
+        Band::Eu2400 => 4,
+        Band::Us2400 => 5,
+        Band::Custom => 6,
+    }
+}
+
+pub fn band_from_u8(value: u8) -> Option<Band> {
+    match value {
+        0 => Some(Band::Eu868),
+        1 => Some(Band::Eu868High),
+        2 => Some(Band::Us915),
+        3 => Some(Band::Us915Robust),
+        4 => Some(Band::Eu2400),
+        5 => Some(Band::Us2400),
+        6 => Some(Band::Custom),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::config::Band;
+
+    fn sample_frame(kind: BridgeKind, payload: &[u8]) -> Vec<u8> {
+        encode(kind, payload)
+    }
+
+    #[test]
+    fn decodes_split_and_coalesced_frames() {
+        let a = sample_frame(BridgeKind::Tx, b"hello");
+        let b = sample_frame(BridgeKind::Ping, b"");
+        let mut stream = a.clone();
+        stream.extend_from_slice(&b);
+        let mut decoder = BridgeDecoder::new();
+        assert!(decoder.push(&stream[..3]).is_empty());
+        let frames = decoder.push(&stream[3..]);
+        assert_eq!(frames.len(), 2);
+        assert_eq!(frames[0].kind, BridgeKind::Tx);
+        assert_eq!(frames[0].payload, b"hello");
+        assert_eq!(frames[1].kind, BridgeKind::Ping);
+    }
+
+    #[test]
+    fn skips_leading_garbage_and_bad_crc() {
+        let mut stream = vec![0x00, 0xFF, 0x11];
+        stream.extend_from_slice(&sample_frame(BridgeKind::Tx, b"ok"));
+        let mut decoder = BridgeDecoder::new();
+        let frames = decoder.push(&stream);
+        assert_eq!(frames.len(), 1);
+        assert_eq!(frames[0].payload, b"ok");
+    }
+
+    #[test]
+    fn cfg_roundtrip() {
+        let cfg = CfgPayload {
+            profile: Band::Us915.default_profile(),
+            relay: true,
+        };
+        let encoded = cfg.encode();
+        assert_eq!(CfgPayload::decode(&encoded), Some(cfg));
+    }
+
+    #[test]
+    fn rx_roundtrip() {
+        let rx = RxPayload {
+            rssi_dbm: -42,
+            snr_db: 9,
+            crc_ok: true,
+            data: vec![1, 2, 3, 4, 5],
+        };
+        assert_eq!(RxPayload::decode(&rx.encode()), Some(rx));
+    }
+}
diff --git a/crates/fips-lr2021/src/config.rs b/crates/fips-lr2021/src/config.rs
new file mode 100644
index 00000000..42be8819
--- /dev/null
+++ b/crates/fips-lr2021/src/config.rs
@@ -0,0 +1,383 @@
+//! Band profiles and configuration types.
+
+use serde::{Deserialize, Serialize};
+
+/// Supported regulatory / band profiles.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Band {
+    Eu868,
+    Eu868High,
+    Us915,
+    Us915Robust,
+    Eu2400,
+    Us2400,
+    Custom,
+}
+
+impl Band {
+    pub fn parse(s: &str) -> Option<Self> {
+        match s.trim().to_ascii_lowercase().as_str() {
+            "eu868" | "eu-868" => Some(Self::Eu868),
+            "eu868-high" | "eu868_high" | "eu-868-high" => Some(Self::Eu868High),
+            "us915" | "us-915" => Some(Self::Us915),
+            "us915-robust" | "us915_robust" | "us-915-robust" => Some(Self::Us915Robust),
+            "eu2400" | "eu-2400" | "2g4" | "2400" => Some(Self::Eu2400),
+            "us2400" | "us-2400" => Some(Self::Us2400),
+            "custom" => Some(Self::Custom),
+            _ => None,
+        }
+    }
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Eu868 => "eu868",
+            Self::Eu868High => "eu868-high",
+            Self::Us915 => "us915",
+            Self::Us915Robust => "us915-robust",
+            Self::Eu2400 => "eu2400",
+            Self::Us2400 => "us2400",
+            Self::Custom => "custom",
+        }
+    }
+
+    pub fn default_profile(self) -> RadioProfile {
+        match self {
+            Self::Eu868 => RadioProfile {
+                band: self,
+                frequency_hz: 868_100_000,
+                bitrate_kbps: 650,
+                tx_power_dbm: 14,
+                sync_word: DEFAULT_SYNC_WORD,
+                radio_payload: 255,
+                sub_ghz: true,
+            },
+            Self::Eu868High => RadioProfile {
+                band: self,
+                frequency_hz: 869_525_000,
+                bitrate_kbps: 650,
+                tx_power_dbm: 14,
+                sync_word: DEFAULT_SYNC_WORD,
+                radio_payload: 255,
+                sub_ghz: true,
+            },
+            Self::Us915 => RadioProfile {
+                band: self,
+                frequency_hz: 915_000_000,
+                bitrate_kbps: 1300,
+                tx_power_dbm: 22,
+                sync_word: DEFAULT_SYNC_WORD,
+                radio_payload: 255,
+                sub_ghz: true,
+            },
+            Self::Us915Robust => RadioProfile {
+                band: self,
+                frequency_hz: 915_000_000,
+                bitrate_kbps: 650,
+                tx_power_dbm: 22,
+                sync_word: DEFAULT_SYNC_WORD,
+                radio_payload: 255,
+                sub_ghz: true,
+            },
+            Self::Eu2400 | Self::Us2400 => RadioProfile {
+                band: self,
+                frequency_hz: 2_440_000_000,
+                bitrate_kbps: 2600,
+                tx_power_dbm: 12,
+                sync_word: DEFAULT_SYNC_WORD,
+                radio_payload: 255,
+                sub_ghz: false,
+            },
+            Self::Custom => RadioProfile {
+                band: self,
+                frequency_hz: 2_440_000_000,
+                bitrate_kbps: 2600,
+                tx_power_dbm: 12,
+                sync_word: DEFAULT_SYNC_WORD,
+                radio_payload: 255,
+                sub_ghz: false,
+            },
+        }
+    }
+}
+
+pub const DEFAULT_SYNC_WORD: [u8; 4] = [0x12, 0xAD, 0x10, 0x1B];
+
+/// Radio parameters sent to the bridge.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub struct RadioProfile {
+    pub band: Band,
+    pub frequency_hz: u32,
+    /// FLRC bitrate in kbps (2600, 1300, 650, 325).
+    pub bitrate_kbps: u16,
+    pub tx_power_dbm: i8,
+    pub sync_word: [u8; 4],
+    /// Raw FLRC payload bytes per radio packet (255 or 511).
+    pub radio_payload: u16,
+    /// True for the sub-GHz (LF) front end, false for 2.4 GHz (HF).
+    pub sub_ghz: bool,
+}
+
+impl RadioProfile {
+    pub fn validate(&self) -> Result<(), String> {
+        if self.frequency_hz < 150_000_000 || self.frequency_hz > 2_500_000_000 {
+            return Err(format!(
+                "frequency {} Hz is outside the LR2021 range",
+                self.frequency_hz
+            ));
+        }
+        match self.bitrate_kbps {
+            2600 | 2080 | 1300 | 650 | 325 => {}
+            other => return Err(format!("unsupported FLRC bitrate {other} kbps")),
+        }
+        if self.radio_payload < 32 || self.radio_payload > 511 {
+            return Err(format!(
+                "radio_payload {} is outside 32..=511",
+                self.radio_payload
+            ));
+        }
+        if self.tx_power_dbm < -18 || self.tx_power_dbm > 22 {
+            return Err(format!(
+                "tx_power {} dBm is outside -18..=22",
+                self.tx_power_dbm
+            ));
+        }
+        if self.sub_ghz != (self.frequency_hz < 1_000_000_000) {
+            return Err("sub_ghz does not match frequency".to_string());
+        }
+        Ok(())
+    }
+}
+
+/// Host-side link configuration.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LinkConfig {
+    pub local_id: u32,
+    /// Largest FIPS frame accepted from / delivered to FIPS.
+    pub mtu: u16,
+    /// Raw radio packet size; must match the bridge configuration.
+    pub radio_payload: u16,
+    pub max_retries: u8,
+    pub ack_timeout_ms: u64,
+    pub reassembly_timeout_ms: u64,
+    pub dedup_window_ms: u64,
+}
+
+impl Default for LinkConfig {
+    fn default() -> Self {
+        Self {
+            local_id: 1,
+            mtu: 1400,
+            radio_payload: 255,
+            max_retries: 3,
+            ack_timeout_ms: 40,
+            reassembly_timeout_ms: 500,
+            dedup_window_ms: 5_000,
+        }
+    }
+}
+
+impl LinkConfig {
+    /// Maximum DATA payload per radio packet after the link header and CRC.
+    pub fn max_fragment_payload(&self) -> usize {
+        let overhead = crate::frame::HEADER_SIZE + crate::frame::CRC_SIZE;
+        (self.radio_payload as usize).saturating_sub(overhead)
+    }
+}
+
+/// Bridge/serial configuration.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BridgeConfig {
+    pub port: String,
+    pub baud: u32,
+    pub profile: RadioProfile,
+    pub relay: bool,
+}
+
+impl Default for BridgeConfig {
+    fn default() -> Self {
+        Self {
+            port: "/dev/ttyACM0".to_string(),
+            baud: 2_000_000,
+            profile: Band::Eu2400.default_profile(),
+            relay: false,
+        }
+    }
+}
+
+/// User-facing FIPS configuration for the `lr2021` transport.
+///
+/// Every field has a default so a minimal config is:
+/// ```yaml
+/// transports:
+///   lr2021:
+///     port: /dev/ttyACM0
+///     band: us915
+/// ```
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Lr2021Config {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub port: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub baud: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub band: Option<Band>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub frequency_hz: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub bitrate_kbps: Option<u16>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub tx_power_dbm: Option<i8>,
+    /// Four sync-word bytes as hex, e.g. "12ad101b".
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub sync_word: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub mtu: Option<u16>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub radio_payload: Option<u16>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub local_id: Option<u32>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub relay: Option<bool>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub auto_connect: Option<bool>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub ack_timeout_ms: Option<u64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub max_retries: Option<u8>,
+}
+
+impl Lr2021Config {
+    pub fn band(&self) -> Band {
+        self.band.unwrap_or(Band::Us2400)
+    }
+
+    pub fn profile(&self) -> Result<RadioProfile, String> {
+        let mut profile = self.band().default_profile();
+        if let Some(frequency_hz) = self.frequency_hz {
+            profile.frequency_hz = frequency_hz;
+            profile.sub_ghz = frequency_hz < 1_000_000_000;
+        }
+        if let Some(bitrate_kbps) = self.bitrate_kbps {
+            profile.bitrate_kbps = bitrate_kbps;
+        }
+        if let Some(tx_power_dbm) = self.tx_power_dbm {
+            profile.tx_power_dbm = tx_power_dbm;
+        }
+        if let Some(radio_payload) = self.radio_payload {
+            profile.radio_payload = radio_payload;
+        }
+        if let Some(sync_word) = &self.sync_word {
+            profile.sync_word = parse_sync_word(sync_word)?;
+        }
+        profile.validate()?;
+        Ok(profile)
+    }
+
+    pub fn port(&self) -> &str {
+        self.port.as_deref().unwrap_or("/dev/ttyACM0")
+    }
+
+    pub fn baud(&self) -> u32 {
+        self.baud.unwrap_or(2_000_000)
+    }
+
+    pub fn relay(&self) -> bool {
+        self.relay.unwrap_or(false)
+    }
+
+    pub fn auto_connect(&self) -> bool {
+        self.auto_connect.unwrap_or(false)
+    }
+
+    pub fn local_id(&self) -> u32 {
+        self.local_id.unwrap_or(1)
+    }
+
+    pub fn bridge_config(&self) -> Result<BridgeConfig, String> {
+        Ok(BridgeConfig {
+            port: self.port().to_string(),
+            baud: self.baud(),
+            profile: self.profile()?,
+            relay: self.relay(),
+        })
+    }
+
+    pub fn link_config(&self) -> Result<LinkConfig, String> {
+        let profile = self.profile()?;
+        let mut cfg = LinkConfig {
+            local_id: self.local_id(),
+            radio_payload: profile.radio_payload,
+            ..LinkConfig::default()
+        };
+        if let Some(mtu) = self.mtu {
+            cfg.mtu = mtu;
+        }
+        if let Some(ack_timeout_ms) = self.ack_timeout_ms {
+            cfg.ack_timeout_ms = ack_timeout_ms;
+        }
+        if let Some(max_retries) = self.max_retries {
+            cfg.max_retries = max_retries;
+        }
+        if cfg.mtu < 64 {
+            return Err("mtu must be at least 64".to_string());
+        }
+        if cfg.max_fragment_payload() < 32 {
+            return Err("radio_payload is too small for the link header".to_string());
+        }
+        Ok(cfg)
+    }
+}
+
+pub fn parse_sync_word(s: &str) -> Result<[u8; 4], String> {
+    let clean: String = s.chars().filter(|c| c.is_ascii_hexdigit()).collect();
+    if clean.len() != 8 {
+        return Err("sync_word must contain exactly 8 hex digits".to_string());
+    }
+    let mut out = [0u8; 4];
+    for (i, byte) in out.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(&clean[i * 2..i * 2 + 2], 16)
+            .map_err(|_| "invalid sync_word".to_string())?;
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn band_profiles_validate() {
+        for band in [
+            Band::Eu868,
+            Band::Eu868High,
+            Band::Us915,
+            Band::Us915Robust,
+            Band::Eu2400,
+            Band::Us2400,
+            Band::Custom,
+        ] {
+            band.default_profile().validate().unwrap();
+        }
+    }
+
+    #[test]
+    fn sync_word_parses() {
+        assert_eq!(parse_sync_word("12ad101b").unwrap(), DEFAULT_SYNC_WORD);
+        assert_eq!(parse_sync_word("12:AD:10:1B").unwrap(), DEFAULT_SYNC_WORD);
+        assert!(parse_sync_word("12ad10").is_err());
+    }
+
+    #[test]
+    fn custom_frequency_selects_band_path() {
+        let cfg = Lr2021Config {
+            band: Some(Band::Custom),
+            frequency_hz: Some(868_300_000),
+            ..Lr2021Config::default()
+        };
+        let profile = cfg.profile().unwrap();
+        assert!(profile.sub_ghz);
+        assert_eq!(profile.frequency_hz, 868_300_000);
+    }
+}
