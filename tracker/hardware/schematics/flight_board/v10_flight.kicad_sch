	(text "BALLOON v10 HUB FLIGHT BOARD - DESIGN-INTENT schematic. Connectivity is taken from the connectivity registry, NOT from the PCB. (ADR-128)"
		(exclude_from_sim no)
		(at 30.48 20.32 0)
